# ==============================================================================
# Campus Placement Management System - Environment Variables Template
# Copy this file to .env (never commit .env) or configure these in IntelliJ IDEA.
# ==============================================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/campus-placement-system
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT Configuration
# Generate a secure 256-bit+ secret (at least 32 characters / Base64 encoded):
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-secure-random-secret-of-at-least-32-characters
# Token expiration in milliseconds (e.g., 86400000 = 24 hours, 3600000 = 1 hour)
JWT_EXPIRATION=86400000

# Optional server port
SERVER_PORT=8080
